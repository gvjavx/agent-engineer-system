# Copy this file to .env and fill in every value before running docker compose.

### Domain (for Caddy automatic HTTPS — must point at this server's IP)
DOMAIN=your-domain.example.com

### Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for agent sessions (defaults to the SDK's default model)
# CLAUDE_MODEL=claude-sonnet-5

### GitHub (Personal Access Token with repo scope, or a GitHub App installation token)
GITHUB_TOKEN=ghp_...

### Meta WhatsApp Business Cloud API
# From your Meta App > WhatsApp > API Setup
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345
META_APP_SECRET=your-meta-app-secret
# Any string you choose; must match what you enter in the Meta webhook config screen
META_VERIFY_TOKEN=choose-a-random-string
META_GRAPH_API_VERSION=v21.0

# Comma-separated list of WhatsApp numbers (E.164 without '+', e.g. 6281234567890)
# allowed to command the agent. Messages from any other number are ignored.
ALLOWED_SENDERS=6281234567890

# Your own WhatsApp number (E.164 without '+'), used as the default notification target.
OWNER_WHATSAPP_NUMBER=6281234567890

### Internal service-to-service auth (any long random string; must match between services)
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

### Git commit identity used by the agent inside every workspace
GIT_AUTHOR_NAME=Autonomous Dev Agent
GIT_AUTHOR_EMAIL=agent@example.com
