# Copy this file to .env and fill in every value before running docker compose.

### Domain (for Caddy automatic HTTPS — must point at this server's IP)
DOMAIN=your-domain.example.com

### AI providers — free tier, tried in this order with automatic fallback.
# Only the providers listed here need their env vars filled in below.
AI_PROVIDER_ORDER=gemini,openrouter,qwen

# Any <NAME>_API_KEY below (including GEMINI_API_KEY) accepts a comma-separated
# list of keys, e.g. GEMINI_API_KEY=key1,key2,key3 — useful if you've got
# several free-tier keys for the same provider. The agent rotates to the next
# key when the current one hits a rate limit/quota error, and only falls
# through to a different provider once every key for this one is exhausted.

# Gemini: free API key from Google AI Studio (https://aistudio.google.com/apikey),
# no credit card needed. Google regularly retires specific model names from the
# free tier (gemini-2.5-flash and gemini-2.0-flash both dropped to a 0-request
# free quota for new API keys within the same year). The "-flash-lite" variant
# below got a usable free quota in testing; the flagship "-flash-latest" alias
# tracks Google's newest model but currently only allows 5 req/min free — too
# tight for a multi-tool-call agent turn. Check
# https://ai.google.dev/gemini-api/docs/rate-limits for current limits, and
# https://ai.google.dev/gemini-api/docs/models for the full model list.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Each Gemini model has its own separate free-tier quota, so a 429 on
# GEMINI_MODEL doesn't mean these are limited too — the agent tries them,
# same key, before rotating to the next key/provider. Comma-separated, same
# format as GEMINI_API_KEY above. Send "daftar model gemini" on WhatsApp to
# see which models actually work with your key right now.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# OpenRouter: free API key from https://openrouter.ai/keys, email signup only.
# Aggregates many ":free" models from different vendors under one API —
# check openrouter.ai/models for the current free list (it changes over time).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Qwen (Alibaba DashScope, International/Singapore region): needs an Alibaba
# Cloud account. New accounts get 1M input + 1M output tokens free, valid 90
# days from activation — after that this provider needs paid credit.
QWEN_API_KEY=
QWEN_MODEL=qwen3-coder-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# To add ANY other OpenAI-compatible provider (Groq, Mistral, Cerebras,
# Together AI, DeepSeek, ...), no code changes needed — just:
#   1. Add its name to AI_PROVIDER_ORDER above, e.g. AI_PROVIDER_ORDER=gemini,openrouter,qwen,groq
#   2. Fill in <NAME>_API_KEY, <NAME>_BASE_URL, <NAME>_MODEL (name uppercased), e.g.:
#      GROQ_API_KEY=gsk_...
#      GROQ_BASE_URL=https://api.groq.com/openai/v1
#      GROQ_MODEL=llama-3.3-70b-versatile
# See "Memasang AI provider lain" in README.md for details. (A provider with a
# genuinely different wire format, like Gemini, does need a new adapter —
# see apps/orchestrator/src/agent/providers/gemini.ts as the example.)

### GitHub (Personal Access Token with repo scope, or a GitHub App installation token)
GITHUB_TOKEN=ghp_...

### Meta WhatsApp Business Cloud API
# From your Meta App > WhatsApp > API Setup
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345
META_APP_SECRET=your-meta-app-secret
# Any string you choose; must match what you enter in the Meta webhook config screen
META_VERIFY_TOKEN=choose-a-random-string
META_GRAPH_API_VERSION=v21.0
# App ID: the number in your app dashboard's URL (developers.facebook.com/apps/<this>/...).
META_APP_ID=your-app-id
# WhatsApp Business Account ID: shown on the API Setup page as "WhatsApp Business Account ID".
# Needed by scripts/fix-whatsapp-webhook.sh — see "Webhook stops receiving messages"
# in the README troubleshooting section for why this is required.
META_WABA_ID=your-waba-id

# Comma-separated list of WhatsApp numbers (E.164 without '+', e.g. 6281234567890)
# allowed to command the agent. Messages from any other number are ignored.
ALLOWED_SENDERS=6281234567890

# Your own WhatsApp number (E.164 without '+'), used as the default notification target.
OWNER_WHATSAPP_NUMBER=6281234567890

### Internal service-to-service auth (any long random string; must match between services)
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

### Git commit identity used by the agent inside every workspace
GIT_AUTHOR_NAME=Autonomous Dev Agent
GIT_AUTHOR_EMAIL=agent@example.com

### Figma (optional — only needed if you want the agent to read Figma designs).
# Register an OAuth app for MCP at https://www.figma.com/developers/apps —
# it needs the "mcp:connect" scope. Leave FIGMA_MCP_CLIENT_ID empty to skip
# this entirely; "hubungkan figma" will just tell the user it's not set up.
FIGMA_MCP_CLIENT_ID=
FIGMA_MCP_CLIENT_SECRET=
# Must match exactly what you register as the app's redirect URI — the
# public gateway URL (same host as your Meta webhook) + /figma/oauth/callback.
FIGMA_OAUTH_REDIRECT_URI=https://your-domain.example.com/figma/oauth/callback

### Local dev only (running `npm run dev:*` directly, not docker compose).
# The defaults baked into the code point at the Docker service names
# ("whatsapp-gateway"/"orchestrator"), which don't resolve outside Docker.
# Uncomment these two when running both services locally:
# GATEWAY_URL=http://localhost:3000
# ORCHESTRATOR_URL=http://localhost:4000
