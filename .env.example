# Copy this file to .env and fill in every value before running docker compose.

### Domain (for Caddy automatic HTTPS — must point at this server's IP)
DOMAIN=your-domain.example.com

### AI providers — free tier, tried in this order with automatic fallback.
# Only the providers listed here need their env vars filled in below.
AI_PROVIDER_ORDER=gemini,openrouter,qwen

# Which provider each department uses before anyone ever sends "pakai model
# <departemen>" on WhatsApp — dept:provider pairs, comma-separated (colon
# because provider specs can themselves contain a "/" for provider/model,
# e.g. "dev:qwen/qwen3-coder-plus"). Leave unset to use the built-in default
# (dev -> qwen, manajemen -> gemini): qwen/openrouter both default to
# qwen3-coder* models above, so coding tasks land on an actually coding-tuned
# model instead of sharing whatever's answering plain chat. A department not
# listed here just falls back to AI_PROVIDER_ORDER as before.
# DEPARTMENT_DEFAULT_PROVIDERS=dev:qwen,manajemen:gemini

# Any <NAME>_API_KEY below (including GEMINI_API_KEY) accepts a comma-separated
# list of keys, e.g. GEMINI_API_KEY=key1,key2,key3 — useful if you've got
# several free-tier keys for the same provider. The agent rotates to the next
# key when the current one hits a rate limit/quota error, and only falls
# through to a different provider once every key for this one is exhausted.

# Gemini: free API key from Google AI Studio (https://aistudio.google.com/apikey),
# no credit card needed. Google regularly retires specific model names from the
# free tier (gemini-2.5-flash and gemini-2.0-flash both dropped to a 0-request
# free quota for new API keys within the same year). The "-flash-lite" variant
# below got a usable free quota in testing; the flagship "-flash-latest" alias
# tracks Google's newest model but currently only allows 5 req/min free — too
# tight for a multi-tool-call agent turn. Check
# https://ai.google.dev/gemini-api/docs/rate-limits for current limits, and
# https://ai.google.dev/gemini-api/docs/models for the full model list.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Each Gemini model has its own separate free-tier quota, so a 429 on
# GEMINI_MODEL doesn't mean these are limited too — the agent tries them,
# same key, before rotating to the next key/provider. Comma-separated, same
# format as GEMINI_API_KEY above. Send "daftar model gemini" on WhatsApp to
# see which models actually work with your key right now.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# OpenRouter: free API key from https://openrouter.ai/keys, email signup only.
# Aggregates many ":free" models from different vendors under one API —
# check openrouter.ai/models for the current free list (it changes over time).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Same idea as GEMINI_FALLBACK_MODELS — no default here since it hasn't been
# live-verified against a real key. Send "daftar model openrouter" on
# WhatsApp to see other ":free" models that actually work right now, then
# list them here comma-separated to let the agent switch models on a 429
# instead of just waiting it out or burning through other keys.
# OPENROUTER_FALLBACK_MODELS=

# Qwen (Alibaba DashScope, International/Singapore region): needs an Alibaba
# Cloud account. New accounts get 1M input + 1M output tokens free, valid 90
# days from activation — after that this provider needs paid credit.
QWEN_API_KEY=
QWEN_MODEL=qwen3-coder-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_FALLBACK_MODELS=

# To add ANY other OpenAI-compatible provider (Groq, Mistral, Cerebras,
# Together AI, DeepSeek, ...), no code changes needed — just:
#   1. Add its name to AI_PROVIDER_ORDER above, e.g. AI_PROVIDER_ORDER=gemini,openrouter,qwen,groq
#   2. Fill in <NAME>_API_KEY, <NAME>_BASE_URL, <NAME>_MODEL (name uppercased), e.g.:
#      GROQ_API_KEY=gsk_...
#      GROQ_BASE_URL=https://api.groq.com/openai/v1
#      GROQ_MODEL=llama-3.3-70b-versatile
# See "Memasang AI provider lain" in README.md for details. (A provider with a
# genuinely different wire format, like Gemini, does need a new adapter —
# see apps/orchestrator/src/agent/providers/gemini.ts as the example.)

### Code retrieval (RAG) for the agent loop — optional, off by default.
# When on, each registered project's tracked files are chunked and embedded,
# and before every task/phase the most relevant snippets are handed to the
# model up front so it spends fewer tool calls hunting for the right file.
# Embeds with the local model (same one as CHAT_KB_SEMANTIC) — no API key, no
# rate limit; needs @huggingface/transformers installed in apps/orchestrator.
# Turning it on without that just does nothing, it never blocks a task.
RAG_ENABLED=false
# How many snippets to inject, and the total character budget for them.
# RAG_TOP_K=8
# RAG_MAX_CONTEXT_CHARS=8000
# Drop hits below this cosine score. 0 = keep everything (rely on RAG_TOP_K);
# raise it once you've seen how your repo scores.
# RAG_MIN_SCORE=0
# Chunk window size / overlap, in lines.
# RAG_CHUNK_LINES=60
# RAG_CHUNK_OVERLAP=10
# Cap on how many changed files one index pass embeds (the rest are picked up
# next pass) — bounds a first index of a big repo.
# RAG_MAX_FILES_PER_INDEX=600

### Chat knowledge base — optional, off by default.
# Records every free-form chat Q&A. When the same question is asked again it's
# answered from the store, not the model. The repeat match is LOCAL (exact
# after normalizing case/punctuation, or near-identical wording) — no API call.
# "lihat memori" shows the count, "lupain semua" wipes it with the fact memory.
CHAT_KB_ENABLED=false
# How close the wording must be to count as the same question. 0.85 tolerates
# a dropped/added filler word; 1.0 = exact words only (order-independent).
# CHAT_KB_LOCAL_THRESHOLD=0.85
# Answers to time-sensitive questions (harga/kurs/cuaca/"sekarang"/"terbaru"/
# a role holder/a recent year/...) are never cached — always answered fresh.
# On top of that, any cached answer older than this many days is ignored and
# re-fetched. 0 = never expire.
# CHAT_KB_MAX_AGE_DAYS=90
# Opt-in: when the text match misses, compare meaning with a small LOCAL
# sentence-embedding model (no API, no rate limit, CPU-only). Catches deeper
# paraphrases ("tanggal berapa indonesia merdeka" == "kapan hari kemerdekaan
# indonesia"). First use downloads a ~120MB model to the transformers cache;
# after that it's offline. Needs @huggingface/transformers installed in
# apps/orchestrator (adds ~200MB of node_modules for onnxruntime).
# CHAT_KB_SEMANTIC=false
# CHAT_KB_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# CHAT_KB_EMBED_DTYPE=q8
# Cosine (this model) to count two questions as the same. Measured: rewordings
# ~0.77-0.90, a merely-related different question ~0.66. 0.75 keeps the first
# and rejects the second. Lower it to catch more paraphrases, at the risk of
# reusing an answer for a subtly different question.
# CHAT_KB_MATCH_THRESHOLD=0.75

### Local generative model for non-coding chat — optional, off by default.
# When on, a small local instruct model answers non-coding chat BEFORE Gemini
# is tried; a failure/timeout/low-quality answer falls back to the configured
# provider. Coding tasks are unaffected. CPU-only, no API. First use downloads
# the model (~1GB at q4 for the 1.5B) to data/hf-cache. Needs
# @huggingface/transformers installed.
#
# Tested: a 0.5B model answers fluently but hallucinates basic facts
# ("kemerdekaan Indonesia -> 24 Agustus 1945"). 1.5B is the realistic floor;
# for good quality, fine-tune it on `npm run export:dataset` output. On CPU a
# 1.5B answer takes ~10-30s.
CHAT_LOCAL_LLM=false
# CHAT_LOCAL_LLM_MODEL=onnx-community/Qwen2.5-1.5B-Instruct
# CHAT_LOCAL_LLM_DTYPE=q4
# CHAT_LOCAL_LLM_TIMEOUT_MS=25000
# CHAT_LOCAL_LLM_MAX_TOKENS=240

### GitHub (Personal Access Token with repo scope, or a GitHub App installation token)
GITHUB_TOKEN=ghp_...

### Meta WhatsApp Business Cloud API
# From your Meta App > WhatsApp > API Setup
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345
META_APP_SECRET=your-meta-app-secret
# Any string you choose; must match what you enter in the Meta webhook config screen
META_VERIFY_TOKEN=choose-a-random-string
META_GRAPH_API_VERSION=v21.0
# App ID: the number in your app dashboard's URL (developers.facebook.com/apps/<this>/...).
META_APP_ID=your-app-id
# WhatsApp Business Account ID: shown on the API Setup page as "WhatsApp Business Account ID".
# Needed by scripts/fix-whatsapp-webhook.sh — see "Webhook stops receiving messages"
# in the README troubleshooting section for why this is required.
META_WABA_ID=your-waba-id

# Comma-separated list of WhatsApp numbers (E.164 without '+', e.g. 6281234567890)
# allowed to command the agent. Messages from any other number are ignored.
ALLOWED_SENDERS=6281234567890

# Your own WhatsApp number (E.164 without '+'), used as the default notification target.
OWNER_WHATSAPP_NUMBER=6281234567890

### Internal service-to-service auth (any long random string; must match between services)
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

### Git commit identity used by the agent inside every workspace
GIT_AUTHOR_NAME=Autonomous Dev Agent
GIT_AUTHOR_EMAIL=agent@example.com

### Figma — currently disabled, leave unset (see "Integrasi Figma" in README.md).
# Figma restricts the mcp:connect OAuth scope to clients they've pre-approved
# themselves; a self-registered app always gets rejected with
# "Invalid scope: mcp:connect", confirmed by Figma support. No self-service
# fix exists. These are left here only so the feature is a one-line revert
# away if Figma opens this up later — don't bother filling them in for now.
FIGMA_MCP_CLIENT_ID=
FIGMA_MCP_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=https://your-domain.example.com/figma/oauth/callback

### Local dev only (running `npm run dev:*` directly, not docker compose).
# The defaults baked into the code point at the Docker service names
# ("whatsapp-gateway"/"orchestrator"), which don't resolve outside Docker.
# Uncomment these two when running both services locally:
# GATEWAY_URL=http://localhost:3000
# ORCHESTRATOR_URL=http://localhost:4000
