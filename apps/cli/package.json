{
  "name": "mas-ade",
  "version": "0.4.0",
  "description": "Terminal client for a Mas ADE agent — drive it from the CLI instead of WhatsApp.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mas-ade": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mas-ade",
    "cli",
    "agent",
    "ai",
    "whatsapp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvjavx/agent-engineer-system.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/gvjavx/agent-engineer-system/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/gvjavx/agent-engineer-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
